{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.gemini/config/plugins/safety-gate.js\""
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.gemini/config/plugins/safety-gate.js\""
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.gemini/config/plugins/safety-gate.js\""
          }
        ]
      }
    ]
  }
}
