{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=xiguamctjwnezbzjipwl",
      "enabled": true
    },
    "android": {
      "type": "local",
      "command": [
        "/home/bashln/.nvm/versions/node/v22.22.3/bin/npx",
        "-y",
        "mcp-android-emulator"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "/home/bashln/.nvm/versions/node/v22.22.3/bin/npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      // "model": "opencode-go/mimo-v2.5",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "task": {
          "*": "deny",
          "auditor": "allow",
          "planner": "allow",
          "tester": "allow",
          "codex": "allow",
          "executor": "allow",
          "analista": "allow",
          "debug": "allow",
          "arquiteto": "allow",
          "goal-worker": "allow"
        }
      }
    },
    "goal-worker": {
      "description": "Executes goal checkpoints autonomously toward a durable objective.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow"
      }
    },
    "executor": {
      "description": "Mechanical execution agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "analista": {
      "description": "Refactor agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "debug": {
      "description": "Debug agent.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent"
    },
    "arquiteto": {
      "description": "Architecture agent.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent"
    },
    "codex": {
      "description": "Critical code agent.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent"
    },
    "tester": {
      "description": "Tester agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "planner": {
      "description": "Planning agent.",
      "model": "openai/gpt-5.4",
      "mode": "subagent"
    },
    "auditor": {
      "description": "Audit and review agent.",
      "model": "openai/gpt-5.4",
      "mode": "subagent"
    },
    "cavecrew-investigator": {
      "model": "opencode/mimo-v2.5-free",
      "mode": "subagent"
    },
    "cavecrew-builder": {
      "model": "opencode/north-mini-code-free",
      "mode": "subagent"
    },
    "cavecrew-reviewer": {
      "model": "github-copilot/claude-haiku-4.5",
      "mode": "subagent"
    },
    "tutor": {
      "model": "opencode/mimo-v2.5-free",
      "mode": "primary"
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/aft-opencode@latest",
    "C:\\Users\\itinerario\\Documents\\leo\\development\\ai-tools\\ponytail\\.opencode\\plugins\\ponytail.mjs"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  }
}
