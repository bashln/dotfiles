{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "xiaomi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xiaomi MiMo",
      "options": {
        "baseURL": "https://token-plan-sgp.xiaomimimo.com/v1",
        "apiKey": "{file:~/.secrets/mimo-api-key}"
      },
      "models": {
        "mimo-v2.5": {
          "name": "MiMo V2.5",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=xiguamctjwnezbzjipwl",
      "enabled": true
    },
    "android": {
      "type": "local",
      "command": [
        "/home/bashln/.nvm/versions/node/v22.22.3/bin/npx",
        "-y",
        "mcp-android-emulator"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "/home/bashln/.nvm/versions/node/v22.22.3/bin/npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "task": {
          "*": "deny",
          "auditor": "allow",
          "planner": "allow",
          "tester": "allow",
          "codex": "allow",
          "executor": "allow",
          "analista": "allow",
          "debug": "allow",
          "arquiteto": "allow",
          "goal-worker": "allow"
        }
      }
    },
    "executor": {
      "description": "Mechanical execution agent.",
      "model": "xiaomi/mimo-v2.5",
      "mode": "subagent"
    },
    "tester": {
      "description": "Tester agent.",
      "model": "xiaomi/mimo-v2.5",
      "mode": "subagent"
    },
    "analista": {
      "description": "Refactor agent.",
      "model": "xiaomi/mimo-v2.5",
      "mode": "subagent"
    },
    "goal-worker": {
      "description": "Executes goal checkpoints autonomously toward a durable objective.",
      "model": "xiaomi/mimo-v2.5",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow"
      }
    },
    "planner": {
      "description": "Planning agent.",
      "model": "openai/gpt-5.4-mini",
      "mode": "subagent"
    },
    "auditor": {
      "description": "Audit and review agent.",
      "model": "openai/gpt-5.4-mini",
      "mode": "subagent"
    },
    "debug": {
      "description": "Debug agent.",
      "model": "openai/gpt-5.4",
      "mode": "subagent"
    },
    "arquiteto": {
      "description": "Architecture agent.",
      "model": "openai/gpt-5.4",
      "mode": "subagent"
    },
    "codex": {
      "description": "Critical code agent.",
      "model": "openai/gpt-5.4",
      "mode": "subagent"
    }
  },
  "plugin": ["./plugins/caveman/plugin.js"]
}
