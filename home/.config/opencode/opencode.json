{
  "$schema": "https://opencode.ai/config.json",
  "theme": "cyberdream",
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "task": {
          "*": "deny",
          "auditor": "allow",
          "planner": "allow",
          "tester": "allow",
          "codex": "allow",
          "executor": "allow",
          "analista": "allow",
          "debug": "allow",
          "arquiteto": "allow",
          "goal-worker": "allow"
        }
      }
    },
    "goal-worker": {
      "description": "Executes goal checkpoints autonomously toward a durable objective.",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow"
      }
    },
    "executor": {
      "description": "Mechanical execution agent.",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent"
    },
    "analista": {
      "description": "Refactor agent.",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent"
    },
    "debug": {
      "description": "Debug agent.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent"
    },
    "arquiteto": {
      "description": "Architecture agent.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent"
    },
    "codex": {
      "description": "Critical code agent.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent"
    },
    "tester": {
      "description": "Tester agent.",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent"
    },
    "planner": {
      "description": "Planning agent.",
      "model": "openai/gpt-5.4",
      "mode": "subagent"
    },
    "auditor": {
      "description": "Audit and review agent.",
      "model": "openai/gpt-5.4",
      "mode": "subagent"
    },
    "cavecrew-investigator": {
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "subagent"
    },
    "cavecrew-builder": {
      "model": "opencode/north-mini-code-free",
      "mode": "subagent"
    },
    "cavecrew-reviewer": {
      "model": "github-copilot/claude-haiku-4.5",
      "mode": "subagent"
    },
    "tutor": {
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "primary"
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/aft-opencode@latest"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  }
}
