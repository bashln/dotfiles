# Esquema de cores do Omarchy para o WezTerm.
# Gerado por omarchy-theme-set-templates a partir deste template do usuario.
# Consumido por ~/.config/wezterm/wezterm.lua no Linux/WSLg.

[metadata]
name = "Omarchy"
author = "Omarchy"

[colors]
background = "{{ background }}"
foreground = "{{ foreground }}"

cursor_bg = "{{ bright_foreground }}"
cursor_border = "{{ bright_foreground }}"
cursor_fg = "{{ background }}"

selection_bg = "{{ selection_background }}"
selection_fg = "{{ selection_foreground }}"

ansi = ["{{ color0 }}", "{{ color1 }}", "{{ color2 }}", "{{ color3 }}", "{{ color4 }}", "{{ color5 }}", "{{ color6 }}", "{{ color7 }}"]
brights = ["{{ color8 }}", "{{ color9 }}", "{{ color10 }}", "{{ color11 }}", "{{ color12 }}", "{{ color13 }}", "{{ color14 }}", "{{ color15 }}"]
