#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# Auto-Mode + Aikido Pre-Commit Hook
# 
# Intercepts git commits, scans staged files for security issues,
# and blocks commits with critical vulnerabilities.
#
# Installation:
#   cp pre-commit ~/.git/hooks/pre-commit
#   chmod +x ~/.git/hooks/pre-commit
#
# Or via the setup script:
#   node setup-hooks.js install
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
AUTO_MODE_DIR="${HOME}/.config/opencode/plugins/auto-mode"
LOG_FILE="${HOME}/.opencode/auto-mode.log"
MAX_RETRIES=3

# ─── Helpers ────────────────────────────────────────────────────────────────

log() {
  local level="$1"
  local msg="$2"
  echo -e "${BLUE}[Auto-Mode]${NC} ${msg}"
  echo "{\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"level\":\"${level}\",\"hook\":\"pre-commit\",\"msg\":\"${msg}\"}" >> "${LOG_FILE}" 2>/dev/null || true
}

warn() {
  echo -e "${YELLOW}[Auto-Mode]${NC} $1"
}

error() {
  echo -e "${RED}[Auto-Mode]${NC} $1"
}

success() {
  echo -e "${GREEN}[Auto-Mode]${NC} $1"
}

# ─── Get staged files ──────────────────────────────────────────────────────

get_staged_files() {
  git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true
}

# ─── Run Aikido scan ───────────────────────────────────────────────────────

scan_files() {
  local files=("$@")
  
  if [ ${#files[@]} -eq 0 ]; then
    echo "CLEAN"
    return 0
  fi

  # Check if Aikido MCP is available
  if ! command -v npx &> /dev/null; then
    warn "npx not found — skipping Aikido scan"
    echo "SKIP"
    return 0
  fi

  # Run scan via integration.js
  local result
  result=$(cd "${AUTO_MODE_DIR}" && node integration.js pre-commit "pre-commit hook" 2>&1) || true
  
  if echo "${result}" | grep -q "DECISION: DENY"; then
    error "Commit blocked by Auto-Mode"
    echo "${result}" | grep -A5 "ISSUES:" || true
    echo "DENY"
    return 1
  elif echo "${result}" | grep -q "DECISION: ESCALATE"; then
    warn "Security issues found — review recommended"
    echo "${result}" | grep -A5 "ISSUES:" || true
    echo "ESCALATE"
    return 0
  else
    echo "CLEAN"
    return 0
  fi
}

# ─── Main ───────────────────────────────────────────────────────────────────

main() {
  log "info" "Pre-commit hook started"
  
  # Get staged files
  local staged_files
  staged_files=$(get_staged_files)
  
  if [ -z "${staged_files}" ]; then
    log "info" "No staged files — skipping scan"
    exit 0
  fi
  
  local file_count
  file_count=$(echo "${staged_files}" | wc -l)
  
  log "info" "Scanning ${file_count} staged file(s)..."
  
  # Convert to array
  local files_array=()
  while IFS= read -r file; do
    files_array+=("${file}")
  done <<< "${staged_files}"
  
  # Run scan
  local scan_result
  scan_result=$(scan_files "${files_array[@]}")
  
  case "${scan_result}" in
    "CLEAN")
      success "No security issues found — commit approved"
      exit 0
      ;;
    "DENY")
      error "Commit BLOCKED — critical security issues found"
      echo ""
      echo "To bypass (not recommended):"
      echo "  git commit --no-verify"
      echo ""
      exit 1
      ;;
    "ESCALATE")
      warn "Security issues found — commit allowed with warning"
      echo ""
      echo "Review the issues above before pushing."
      echo ""
      exit 0
      ;;
    "SKIP")
      warn "Scan skipped — Aikido not available"
      exit 0
      ;;
    *)
      warn "Unexpected scan result: ${scan_result}"
      exit 0
      ;;
  esac
}

# Run main
main