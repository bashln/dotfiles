{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (Free)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "nvidia/nemotron-mini-4b-instruct": {
          "name": "Nemotron Mini 4B",
          "reasoning": false,
          "tool_call": true
        },
        "nvidia/llama-3.1-nemotron-nano-8b-v1": {
          "name": "Llama 3.1 Nemotron Nano 8B",
          "reasoning": true,
          "tool_call": true
        },
        "nvidia/nvidia-nemotron-nano-9b-v2": {
          "name": "Nemotron Nano 9B v2",
          "reasoning": true,
          "tool_call": true
        },
        "nvidia/nemotron-nano-12b-v2-vl": {
          "name": "Nemotron Nano 12B VL",
          "reasoning": true,
          "tool_call": true
        },
        "nvidia/nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30B",
          "reasoning": true,
          "tool_call": true
        },
        "nvidia/nemotron-3.5-lightning-30b-a3b": {
          "name": "Nemotron 3.5 Lightning 30B",
          "reasoning": true,
          "tool_call": true
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "aikido": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@aikidosec/mcp@latest"
      ],
      "enabled": true
    }
  },
  "autoupdate": true,
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "opencode/big-pickle",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "task": {
          "*": "deny",
          "auditor": "allow",
          "planner": "allow",
          "tester": "allow",
          "codex": "allow",
          "executor": "allow",
          "analista": "allow",
          "debug": "allow",
          "arquiteto": "allow",
          "goal-worker": "allow"
        }
      }
    },
    "goal-worker": {
      "description": "Executes goal checkpoints autonomously toward a durable objective.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow"
      }
    },
    "executor": {
      "description": "Mechanical execution agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "analista": {
      "description": "Refactor agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "debug": {
      "description": "Debug agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "arquiteto": {
      "description": "Architecture agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "codex": {
      "description": "Critical code agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "tester": {
      "description": "Tester agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "planner": {
      "description": "Planning agent.",
      "model": "opencode-go/qwen3.7-plus",
      "mode": "subagent"
    },
    "auditor": {
      "description": "Audit and review agent.",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "cavecrew-investigator": {
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "cavecrew-builder": {
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "cavecrew-reviewer": {
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "tutor": {
      "model": "opencode-go/mimo-v2.5",
      "mode": "primary"
    }
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@0.42.5",
    "@cortexkit/aft-opencode@latest"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  }
}