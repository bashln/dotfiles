{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "nvidia": {
      "name": "NVIDIA NIM (Free)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "nvidia/nemotron-mini-4b-instruct": {
          "name": "Nemotron Mini 4B",
          "capabilities": {
            "tools": true
          }
        },
        "nvidia/llama-3.1-nemotron-nano-8b-v1": {
          "name": "Llama 3.1 Nemotron Nano 8B",
          "capabilities": {
            "tools": true
          }
        },
        "nvidia/nvidia-nemotron-nano-9b-v2": {
          "name": "Nemotron Nano 9B v2",
          "capabilities": {
            "tools": true
          }
        },
        "nvidia/nvidia-nemotron-nano-12b-v2-vl": {
          "name": "Nemotron Nano 12B VL",
          "capabilities": {
            "tools": true
          }
        },
        "nvidia/nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30B A3B",
          "capabilities": {
            "tools": true
          }
        },
        "nvidia/nemotron-3.5-lightning-30b-a3b": {
          "name": "Nemotron 3.5 Lightning 30B A3B",
          "capabilities": {
            "tools": true
          }
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "capabilities": {
            "tools": true
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "aikido": {
        "type": "local",
        "command": [
          "node",
          "-e",
          "const{spawn}=require('child_process');const f=require('path').join(require('os').homedir(),'.config','opencode','scripts','aikido-mcp.cjs');const c=spawn(process.execPath,[f],{stdio:'inherit',windowsHide:true});c.on('exit',(x,s)=>process.exit(s?1:(x??0)));"
        ],
        "disabled": false
      }
    }
  },
  "update": "disable",
  "default_agent": "build",
  "agents": {
    "plan": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "dir *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "wc *", "effect": "allow" },
        { "action": "shell", "resource": "pwd*", "effect": "allow" },
        { "action": "shell", "resource": "npm test*", "effect": "ask" },
        { "action": "shell", "resource": "npx jest*", "effect": "ask" },
        { "action": "shell", "resource": "go test*", "effect": "ask" },
        { "action": "shell", "resource": "cargo test*", "effect": "ask" },
        { "action": "shell", "resource": "pytest*", "effect": "ask" },
        { "action": "shell", "resource": "bun test*", "effect": "ask" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" }
      ]
    },
    "build": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "auditor", "effect": "allow" },
        { "action": "subagent", "resource": "planner", "effect": "allow" },
        { "action": "subagent", "resource": "tester", "effect": "allow" },
        { "action": "subagent", "resource": "codex", "effect": "allow" },
        { "action": "subagent", "resource": "executor", "effect": "allow" },
        { "action": "subagent", "resource": "analista", "effect": "allow" },
        { "action": "subagent", "resource": "debug", "effect": "allow" },
        { "action": "subagent", "resource": "arquiteto", "effect": "allow" },
        { "action": "subagent", "resource": "goal-worker", "effect": "allow" }
      ]
    },
    "goal-worker": {
      "description": "Executes goal checkpoints autonomously toward a durable objective.",
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" }
      ]
    },
    "executor": {
      "description": "Mechanical execution agent.",
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent"
    },
    "analista": {
      "description": "Refactor agent.",
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent"
    },
    "debug": {
      "description": "Debug agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "arquiteto": {
      "description": "Architecture agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "codex": {
      "description": "Critical code agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "tester": {
      "description": "Tester agent.",
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent"
    },
    "planner": {
      "description": "Planning agent.",
      "model": "opencode-go/qwen3.7-plus",
      "mode": "subagent"
    },
    "auditor": {
      "description": "Audit and review agent.",
      "model": "opencode-go/mimo-v2.6-pro",
      "mode": "subagent"
    },
    "auto-mode": {
      "description": "Auto-review agent for dangerous actions. Intercepts commands that cross safety boundaries.",
      "model": "opencode-go/mimo-v2.6-pro",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" }
      ]
    },
    "safety-checker": {
      "description": "Safety verification agent for Auto-Mode. Read-only risk assessment.",
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" }
      ]
    },
    "cavecrew-investigator": {
      "model": "opencode-go/mimo-v2.6-pro",
      "mode": "subagent"
    },
    "cavecrew-builder": {
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent"
    },
    "cavecrew-reviewer": {
      "model": "opencode-go/mimo-v2.6-pro",
      "mode": "subagent"
    },
    "tutor": {
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "primary"
    }
  },
  "plugins": [],
  "compaction": {
    "auto": false
  },
  "auto_mode": {
    "enabled": true,
    "policy": "auto-mode-policy.md",
    "circuit_breaker": {
      "max_consecutive_denials": 3,
      "max_denials_in_window": 10,
      "window_size": 50
    },
    "escalation_timeout": 300,
    "log_file": "~/.opencode/auto-mode.log"
  }
}
