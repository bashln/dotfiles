{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aikido": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@aikidosec/mcp@latest"
      ],
      "enabled": true
    }
  },
  "autoupdate": true,
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "opencode/big-pickle",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "task": {
          "*": "deny",
          "auditor": "allow",
          "planner": "allow",
          "tester": "allow",
          "codex": "allow",
          "executor": "allow",
          "analista": "allow",
          "debug": "allow",
          "arquiteto": "allow",
          "goal-worker": "allow"
        }
      }
    },
    "goal-worker": {
      "description": "Executes goal checkpoints autonomously toward a durable objective.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow"
      }
    },
    "executor": {
      "description": "Mechanical execution agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "analista": {
      "description": "Refactor agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "debug": {
      "description": "Debug agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "arquiteto": {
      "description": "Architecture agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "codex": {
      "description": "Critical code agent.",
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "subagent"
    },
    "tester": {
      "description": "Tester agent.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "planner": {
      "description": "Planning agent.",
      "model": "opencode-go/qwen3.7-plus",
      "mode": "subagent"
    },
    "auditor": {
      "description": "Audit and review agent.",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "auto-mode": {
      "description": "Auto-review agent for dangerous actions. Intercepts commands that cross safety boundaries.",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "cat *": "allow",
          "ls *": "allow"
        }
      }
    },
    "safety-checker": {
      "description": "Safety verification agent for Auto-Mode. Read-only risk assessment.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "cat *": "allow"
        }
      }
    },
    "cavecrew-investigator": {
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "cavecrew-builder": {
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "cavecrew-reviewer": {
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "tutor": {
      "model": "opencode-go/mimo-v2.5",
      "mode": "primary"
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    "./plugins/ponytail/.opencode/plugins/ponytail.mjs",
    "@cortexkit/opencode-magic-context@0.42.5",
    "@cortexkit/aft-opencode@latest",
    "./plugins/auto-mode/plugin.js",
    "./plugins/auto-mode/integration.js",
    "./plugins/auto-mode/background.js"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "auto_mode": {
    "enabled": true,
    "policy": "auto-mode-policy.md",
    "circuit_breaker": {
      "max_consecutive_denials": 3,
      "max_denials_in_window": 10,
      "window_size": 50
    },
    "escalation_timeout": 300,
    "log_file": "~/.opencode/auto-mode.log",
    "aikido": {
      "enabled": true,
      "scan_on_edit": true,
      "pre_commit_scan": true,
      "domain_check": true
    }
  }
}