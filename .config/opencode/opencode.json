    "goal-worker": {
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent"
    },
    "executor": {
      "description": "Mechanical execution agent. Runs a precise, fully-specified sequence to the letter: file moves, fixture updates, scripted edits. Use when the task is unambiguous and needs no judgment.",
      "model": "opencode-go/mimo-v2.6-flash",
      "mode": "subagent"
    },
    "analista": {
      "description": "Behavior-preserving refactor. Rename, extract, inline, dedupe, move. Use for structural changes that must not alter behavior.",
      "model": "opencode-go/mimo-v2.6-pro",
      "mode": "subagent"
    },
    "debug": {
      "description": "Debug agent. Reproduces a defect, isolates the root cause, proposes the minimal fix. Use for failing tests, crashes, and unexpected behavior.",
      "model": "opencode-go/mimo-v2.6-pro",
      "mode": "subagent"
    },
    "arquiteto": {
      "description": "Architecture agent. Parallel design exploration before implementation: sketches types, boundaries, and module structure. Use for non-trivial design decisions.",
      "model": "opencode-go/mimo-v2.6-pro",
      "mode": "subagent"
    },
    "codex": {
      "description": "Critical code agent. Adversarial review of a diff or design; hunts edge cases and failure modes. Use before shipping risky changes.",
